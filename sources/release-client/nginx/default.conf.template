# Serves the release client (static single page application) and forwards the API requests to the
# release server, so the UI and the API share one origin.
server {
    listen 3000;
    listen [::]:3000;
    server_name _;

    root /usr/share/nginx/html;

    # Resolve the release server per request (Docker DNS), so the client also starts while the server
    # container is not running yet
    resolver ${NGINX_LOCAL_RESOLVERS} valid=30s;
    set $release_server ${RELEASE_SERVER_URL};

    location /artifacts {
        proxy_pass $release_server;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Uploads and backups can be large; the release server enforces its own limits
        client_max_body_size 0;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # File names of the build output contain a content hash
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
